# База данных PostgreSQL (по закону РУз данные граждан — на серверах в Узбекистане)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/bileto?schema=public"

PORT=3000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# CORS (для будущей веб-админки); мобильному приложению CORS не нужен
ALLOWED_ORIGINS=http://localhost:5173

# Swagger /docs под basic auth (если не заданы — открыт)
SWAGGER_USER=
SWAGGER_PASSWORD=

# Telegram: бот от @BotFather и чат операторов (группа, куда добавлен бот).
# Пока не заданы — заявки и объявления только пишутся в лог.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Кнопки в чате работают через long polling. Запускайте с polling только один экземпляр сервера.
TELEGRAM_POLLING=true

# Ключ для /api/admin/* (заголовок X-Admin-Key), минимум 16 символов
ADMIN_API_KEY=

# Сервисный сбор с покупателя, % (оплата — вне приложения)
SERVICE_FEE_PERCENT=7
# Комиссия Bileto с продавца с каждого проданного билета, %
SELLER_COMMISSION_PERCENT=10
