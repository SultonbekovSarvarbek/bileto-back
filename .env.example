# База данных PostgreSQL (по закону РУз данные граждан — на серверах в Узбекистане)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/bileto?schema=public"

PORT=3000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# CORS (для админки/веба); мобильному приложению CORS не нужен
ALLOWED_ORIGINS=http://localhost:5173

# Swagger /docs под basic auth (если не заданы — открыт)
SWAGGER_USER=
SWAGGER_PASSWORD=

# SMS: console — код пишется в лог сервера
SMS_PROVIDER=console
# Только для разработки: вернуть код в ответе /auth/otp/send. В production игнорируется.
OTP_DEV_ECHO=true

# Оплата: mock — POST /orders/:id/pay сразу помечает заказ оплаченным. В production игнорируется.
PAYMENT_PROVIDER=mock

# Правила сделки
SERVICE_FEE_PERCENT=7
PAYMENT_TIMEOUT_MIN=15
HANDOVER_DEADLINE_HOURS=2
CONFIRM_WINDOW_HOURS=24

# Администратор, которого создаёт npm run seed
ADMIN_PHONE=+998900000000
