generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Кто пользователь на Bileto: продавать могут только продавцы.
enum UserRole {
  BUYER
  SELLER
}

enum Lang {
  ru
  en
  uz
}

enum Delivery {
  DELIVERY // продавец доставляет билет покупателю
  PICKUP // покупатель забирает билет у продавца
}

enum ListingStatus {
  ACTIVE
  SOLD // всё количество продано
  REJECTED // снято модератором
  ARCHIVED // снято продавцом
}

// Заявка на покупку: оператор обрабатывает её в Telegram, оплата — вне приложения.
enum RequestStatus {
  NEW
  IN_PROGRESS
  DONE // продано: билеты списываются с объявления
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  phone     String   @unique // +998XXXXXXXXX
  name      String?
  role      UserRole @default(BUYER)
  lang      Lang     @default(ru)
  verified  Boolean  @default(false) // верификация через MyID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings  Listing[]
  requests  PurchaseRequest[]
  favorites Favorite[]
}

model Listing {
  id           String        @id @default(uuid())
  sellerId     String
  seller       User          @relation(fields: [sellerId], references: [id])
  eventId      String? // событие из каталога приложения: обложка, дата и площадка
  title        String
  city         String
  description  String? // описание продавца: место, ряд, формат билета. Контакты вырезаются
  qty          Int // сколько билетов выставлено всего
  qtyAvailable Int // сколько ещё не продано
  price        Int // цена за 1 билет, сум
  delivery     Delivery
  proofPath    String // файл фото продавца: уходит модераторам в Telegram
  status       ListingStatus @default(ACTIVE)
  rejectReason String?
  coverUrl     String? // обложка: фото продавца (/photos/…) или афиша iticket.uz у импортированных
  sourceUrl    String?       @unique // импорт с OLX: оператор связывается с продавцом там
  views        Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  requests  PurchaseRequest[]
  favorites Favorite[]

  @@index([status, city, createdAt])
  @@index([sellerId])
}

model PurchaseRequest {
  id          String        @id @default(uuid())
  number      Int           @unique @default(autoincrement()) // номер заявки для операторов: #12
  listingId   String
  listing     Listing       @relation(fields: [listingId], references: [id])
  userId      String? // если покупатель вошёл в приложение
  user        User?         @relation(fields: [userId], references: [id])
  name        String
  phone       String
  qty         Int
  unitPrice   Int
  subtotal    Int
  fee         Int // сервисный сбор, сум
  total       Int
  status      RequestStatus @default(NEW)
  tgMessageId Int? // сообщение с заявкой в Telegram-чате операторов
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([listingId])
  @@index([phone, createdAt])
}

model Favorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, listingId])
}
