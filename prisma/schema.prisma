generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Кто пользователь на Bileto: продавать могут только продавцы.
enum UserRole {
  BUYER
  SELLER
}

enum Lang {
  ru
  en
  uz
}

enum Delivery {
  DELIVERY // продавец доставляет билет покупателю
  PICKUP // покупатель забирает билет у продавца
}

enum ListingStatus {
  ACTIVE
  SOLD // всё количество продано
  REJECTED // снято модератором
  ARCHIVED // снято продавцом
}

// Заявка на покупку: оператор обрабатывает её в Telegram, оплата — вне приложения.
enum RequestStatus {
  NEW
  IN_PROGRESS
  DONE // продано: билеты списываются с объявления
  CANCELLED
}

// Предложение цены покупателем: отвечает продавец, принятое становится заявкой.
enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model User {
  id           String    @id @default(uuid())
  phone        String    @unique // +998XXXXXXXXX
  passwordHash String? // scrypt "соль:хеш"; null — аккаунт заведён до паролей, пароль задаётся регистрацией
  telegramId   String?   @unique // вход через публичного Telegram-бота: номер подтверждён контактом
  name         String?
  role         UserRole  @default(BUYER)
  lang         Lang      @default(ru)
  verified     Boolean   @default(false) // верификация через MyID
  deletedAt    DateTime? // аккаунт удалён пользователем: имя и телефон стёрты
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  listings  Listing[]
  requests  PurchaseRequest[]
  favorites Favorite[]
  offers    PriceOffer[]
}

model Listing {
  id           String        @id @default(uuid())
  sellerId     String
  seller       User          @relation(fields: [sellerId], references: [id])
  eventId      String? // событие из каталога приложения: обложка, дата и площадка
  title        String
  city         String
  description  String? // описание продавца: место, ряд, формат билета. Контакты вырезаются
  qty          Int // сколько билетов выставлено всего
  qtyAvailable Int // сколько ещё не продано
  price        Int // цена за 1 билет, сум
  negotiable   Boolean       @default(false) // торг уместен: покупатель может предложить свою цену
  delivery     Delivery
  proofPath    String? // файл фото продавца (необязательное): уходит модераторам в Telegram
  status       ListingStatus @default(ACTIVE)
  rejectReason String?
  coverUrl     String? // обложка: фото продавца (/photos/…) или афиша iticket.uz у импортированных
  sourceUrl    String?       @unique // импорт с OLX: оператор связывается с продавцом там
  views        Int           @default(0)
  deletedAt    DateTime? // продавец удалил объявление: скрыто от всех, кроме операторов
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  requests  PurchaseRequest[]
  favorites Favorite[]
  offers    PriceOffer[]

  @@index([status, city, createdAt])
  @@index([sellerId])
}

model PurchaseRequest {
  id          String        @id @default(uuid())
  number      Int           @unique @default(autoincrement()) // номер заявки для операторов: #12
  listingId   String
  listing     Listing       @relation(fields: [listingId], references: [id])
  userId      String? // если покупатель вошёл в приложение
  user        User?         @relation(fields: [userId], references: [id])
  name        String
  phone       String
  qty         Int
  unitPrice   Int
  subtotal    Int
  fee         Int // сервисный сбор, сум
  total       Int
  status      RequestStatus @default(NEW)
  tgMessageId Int? // сообщение с заявкой в Telegram-чате операторов
  offerId     String?       @unique // заявка появилась из принятого предложения цены
  offer       PriceOffer?   @relation(fields: [offerId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([listingId])
  @@index([phone, createdAt])
}

// Покупатель предлагает свою цену за билет с пометкой «торг уместен».
// Продавец видит имя из Telegram и размытый номер; принятое предложение становится заявкой.
model PriceOffer {
  id        String      @id @default(uuid())
  listingId String
  listing   Listing     @relation(fields: [listingId], references: [id])
  userId    String // покупатель
  user      User        @relation(fields: [userId], references: [id])
  name      String // имя покупателя из Telegram
  phone     String
  qty       Int
  price     Int // предложенная цена за 1 билет, сум
  listPrice Int // цена в объявлении на момент предложения
  status    OfferStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  request PurchaseRequest?

  @@index([listingId, status])
  @@index([userId, createdAt])
}

model Favorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, listingId])
}

// Чат публичного Telegram-бота: язык и визиты — и до того, как человек поделился номером.
model BotChat {
  id          String   @id // Telegram ID пользователя
  lang        Lang     @default(ru)
  lastSeenAt  DateTime @default(now()) // для статистики активных, обновляется не чаще раза в час
  firstSource String? // метка ?start=…, с которой человек пришёл в бота впервые; не перезаписывается
  lastSource  String? // метка последнего перехода по ссылке
  createdAt   DateTime @default(now()) // первый визит
  updatedAt   DateTime @updatedAt
}

// Переход в бота по ссылке с меткой (?start=sell_zivert_a): одна строка на каждый /start.
model BotStart {
  id        Int      @id @default(autoincrement())
  chatId    String // Telegram ID пользователя
  source    String
  isNew     Boolean // первый визит человека в бота
  createdAt DateTime @default(now())

  @@index([source, createdAt])
}
